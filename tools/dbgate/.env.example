# DbGate optional login (TEMPLATE) — only needed if you uncomment the LOGIN/PASSWORD
# lines in docker-compose.yml (see README.md "Enabling login").
#
#     cp tools/dbgate/.env.example tools/dbgate/.env
#
# The real .env is gitignored — never commit it. By default DbGate runs with no login
# since it's bound to 127.0.0.1 only; only add this if you want defense-in-depth on a
# shared dev machine.
DBGATE_LOGIN=admin
DBGATE_PASSWORD=<choose-a-local-password>
