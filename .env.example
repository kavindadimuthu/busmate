# Copy to .env and fill in real values. Never commit .env — it's gitignored.
#
# Deviates from the plan doc in one place on purpose: docs/user-management/user-management-
# implementation-plan.md's Phase 13.3 snippet writes the real SUPABASE_JWT_SECRET directly
# into this file. That value is real and already live — writing it into a template file meant
# to be committed would permanently expose it in git history. Use placeholders here; the real
# values live only in the gitignored .env.

# API Gateway
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here
ALLOWED_ORIGINS=http://localhost:3000,https://busmate-web-frontend.vercel.app

# User Management Service
SUPABASE_URL=https://gvxbzcxjueghvrtsfdxc.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<from-supabase-dashboard>
SUPABASE_ANON_KEY=<from-supabase-dashboard>
INTERNAL_API_KEY=<generate-a-secure-random-string>

# User Management Service — database (Supabase Postgres pooler)
SPRING_DATASOURCE_URL=jdbc:postgresql://<pooler-host>:6543/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=<from-supabase-dashboard>
SPRING_DATASOURCE_PASSWORD=<from-supabase-dashboard>

# Ticketing service is on its own separate redesign track — still really listening on 8083,
# not the 8082 this plan's target port table assumes.
TICKETING_SERVICE_URL=http://ticketing-service:8083
