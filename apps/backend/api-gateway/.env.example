PORT=8080
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here
# Gateway remains the single public backend entry point on 8080.
# Downstream services use internal/private ports to avoid colliding with the gateway.
USER_SERVICE_URL=http://localhost:9020
CORE_SERVICE_URL=http://localhost:9010
TICKETING_SERVICE_URL=http://localhost:9030
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:4000,https://busmate-web-frontend.vercel.app
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
NODE_ENV=development
