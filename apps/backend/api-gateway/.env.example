PORT=8080
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here
# NOTE: target port allocation is user-management=8081, ticketing-service=8082, api-core=8083.
# As of this writing ticketing-service still listens on 8083 and api-core still listens on 8080
# (which collides with this gateway) — update these once those services are reassigned.
USER_MANAGEMENT_URL=http://localhost:8081
TICKETING_SERVICE_URL=http://localhost:8083
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:4000,https://busmate-web-frontend.vercel.app
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
NODE_ENV=development
