<?xml version="1.0" encoding="UTF-8"?>
<!--
  Observability Phase 1: profile-aware logging.

  - dev / test / default : human-readable console, including the correlation id
    (requestId) that RequestIdFilter places in the SLF4J MDC.
  - prod / e2e           : single-line JSON (logstash-logback-encoder) on stdout so
    Grafana Alloy can ship it to Loki. MDC requestId is included automatically and the
    constant "service" field lets one Loki query span all services + the gateway.

  Log *levels* are still tuned per package via logging.level.* in application*.yml —
  that is applied on top of the <root> level defined here.
-->
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [req:%X{requestId:-}] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdcKeyName>requestId</includeMdcKeyName>
            <customFields>{"service":"user-service"}</customFields>
        </encoder>
    </appender>

    <springProfile name="prod,e2e">
        <root level="INFO">
            <appender-ref ref="JSON"/>
        </root>
    </springProfile>

    <springProfile name="!prod &amp; !e2e">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>
</configuration>
