{
  "name": "user-service",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "root": "apps/backend/user-service",
  "sourceRoot": "apps/backend/user-service/src",
  "tags": ["scope:backend", "type:app", "framework:spring-boot", "lang:java"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/mvnw.mjs {projectRoot} clean compile -DskipTests"
      },
      "outputs": ["{projectRoot}/target/classes"],
      "inputs": [
        "{projectRoot}/src/**/*.java",
        "{projectRoot}/pom.xml",
        "{projectRoot}/src/main/resources/**"
      ],
      "cache": true
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/mvnw.mjs {projectRoot} test"
      },
      "outputs": ["{projectRoot}/target/surefire-reports"],
      "cache": true
    },
    "package": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/mvnw.mjs {projectRoot} clean package -DskipTests"
      },
      "outputs": ["{projectRoot}/target/*.jar"],
      "cache": true
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/mvnw.mjs {projectRoot} spring-boot:run"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/mvnw.mjs {projectRoot} spring-boot:run"
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/mvnw.mjs {projectRoot} clean"
      }
    },
    "docker:build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker build -t busmate/user-service:latest .",
        "cwd": "{projectRoot}"
      }
    }
  }
}
