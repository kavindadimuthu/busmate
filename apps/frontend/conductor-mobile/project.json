{
  "name": "conductor-mobile",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "root": "apps/frontend/conductor-mobile",
  "sourceRoot": "apps/frontend/conductor-mobile/app",
  "tags": ["scope:frontend", "type:app", "framework:expo", "lang:typescript"],
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm dev",
        "cwd": "{projectRoot}"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm start",
        "cwd": "{projectRoot}"
      }
    },
    "android": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm android",
        "cwd": "{projectRoot}"
      }
    },
    "ios": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm ios",
        "cwd": "{projectRoot}"
      }
    },
    "web": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm web",
        "cwd": "{projectRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm lint",
        "cwd": "{projectRoot}"
      },
      "cache": true
    },
    "type-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec tsc --noEmit",
        "cwd": "{projectRoot}"
      },
      "cache": true
    }
  }
}
