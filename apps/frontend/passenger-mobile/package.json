{
  "name": "smart-bus-sri-lanka",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "EXPO_NO_TELEMETRY=1 expo start",
    "build:web": "expo export --platform web",
    "build:android": "eas build --platform android --profile preview",
    "build:android:production": "eas build --platform android --profile production",
    "lint": "expo lint",
    "generate:api-user:cloud": "npx openapi-typescript-codegen --input http://107.21.189.199:8081/v3/api-docs --output ./lib/api-client/user-management",
    "generate:api-route:cloud": "npx openapi-typescript-codegen --input http://18.140.161.237:8080/v3/api-docs --output ./lib/api-client/route-management",
    "generate:api-route:local": "npx openapi-typescript-codegen --input http://localhost:8080/v3/api-docs --output ./lib/api-client/route-management",
    "generate:api-location:local": "npx openapi-typescript-codegen --input http://localhost:4000/api-spec --output ./lib/api-client/location-tracking",
    "generate:api-ticket:cloud": "npx openapi-typescript-codegen --input http://54.91.217.117:8083/v3/api-docs --output ./lib/api-client/ticketing-management",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "postinstall": "npx expo install --fix"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@lucide/lab": "^0.1.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "expo": "^54.0.13",
    "expo-blur": "~15.0.7",
    "expo-camera": "~17.0.8",
    "expo-constants": "~18.0.9",
    "expo-font": "~14.0.9",
    "expo-haptics": "~15.0.7",
    "expo-linear-gradient": "~15.0.7",
    "expo-linking": "~8.0.8",
    "expo-location": "~19.0.7",
    "expo-router": "~6.0.12",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-symbols": "~1.0.7",
    "expo-system-ui": "~6.0.7",
    "expo-web-browser": "~15.0.8",
    "lucide-react-native": "^0.475.0",
    "nativewind": "^2.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-qrcode-svg": "^6.3.15",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "tailwindcss": "3.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "engine-strict": false
}
