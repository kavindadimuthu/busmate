{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@busmate/ui": ["../../../libs/ui/src/index.ts"],
      "@busmate/ui/styles": ["../../../libs/ui/src/styles/globals.css"],
      "@busmate/ui/*": ["../../../libs/ui/src/*"],
      "@busmate/api-client-route": ["../../../libs/api-clients/route-management/src/index.ts"],
      "@busmate/api-client-ticketing": ["../../../libs/api-clients/ticketing-management/src/index.ts"],
      "@busmate/api-client-location": ["../../../libs/api-clients/location-tracking/src/index.ts"],
      "@busmate/api-client-user": ["../../../libs/api-clients/user-management/src/index.ts"]
    },

    /* Linting */
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "exclude": ["src/pages/api"]
}
