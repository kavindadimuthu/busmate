{
  "name": "busmate",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev:conductor-mobile": "pnpm --filter busmatelkconductorapp dev",
    "dev:passenger-mobile": "pnpm --filter smart-bus-sri-lanka dev",
    "dev:passenger-web": "node scripts/nx.mjs dev passenger-web",
    "dev:api-gateway": "pnpm --filter api-gateway dev",
    "dev:new-react-portal": "pnpm --filter @busmate/new-react-portal dev",
    "dev:core-service": "node scripts/mvnw.mjs apps/backend/core-service spring-boot:run",
    "dev:user-service": "node scripts/mvnw.mjs apps/backend/user-service spring-boot:run",
    "dev:ticketing-service": "node scripts/mvnw.mjs apps/backend/ticketing-service spring-boot:run",
    "dev:core-service:jar": "node scripts/with-env.mjs SPRINGDOTENV_DIRECTORY=config/secrets -- java -jar apps/backend/core-service/target/core-service-0.0.1-SNAPSHOT.jar",
    "dev:user-service:jar": "node scripts/with-env.mjs SPRINGDOTENV_DIRECTORY=config/secrets -- java -jar apps/backend/user-service/target/user-service-0.0.1-SNAPSHOT.jar",
    "dev:ticketing-service:jar": "node scripts/with-env.mjs SPRINGDOTENV_DIRECTORY=config/secrets -- java -jar apps/backend/ticketing-service/target/ticketing-service-0.0.1-SNAPSHOT.jar",
    "dev:backend": "docker compose up --build",
    "dev:backend:down": "docker compose down",
    "dev:backend:status": "docker compose ps",
    "dev:backend:logs": "docker compose logs -f",
    "dev-portal": "pnpm --filter @busmate/dev-portal dev",
    "dev-portal:web": "pnpm --filter @busmate/dev-portal dev:web",
    "db:dev:up": "docker compose up -d postgres",
    "db:dev:down": "docker compose stop postgres",
    "db:dev:logs": "docker compose logs -f postgres",
    "db:dev:reset": "docker compose rm -sf postgres && docker volume rm --force busmate_busmate_dev_postgres_data && docker compose up -d postgres",
    "db:dev:psql": "docker compose exec postgres psql -U postgres",
    "db:dev:gui": "docker compose -f tools/dbgate/docker-compose.yml up -d",
    "db:dev:gui:down": "docker compose -f tools/dbgate/docker-compose.yml down",
    "db:dev:gui:logs": "docker compose -f tools/dbgate/docker-compose.yml logs -f dbgate",
    "build": "node scripts/nx.mjs run-many -t build",
    "build:passenger-web": "node scripts/nx.mjs build passenger-web",
    "build:core-service": "node scripts/nx.mjs run core-service:package",
    "build:user-service": "node scripts/mvnw.mjs apps/backend/user-service clean package -DskipTests",
    "build:ticketing-service": "node scripts/mvnw.mjs apps/backend/ticketing-service clean package -DskipTests",
    "build:api-gateway": "pnpm --filter api-gateway build",
    "build:new-react-portal": "pnpm --filter @busmate/new-react-portal build",
    "serve:core-service": "node scripts/mvnw.mjs apps/backend/core-service spring-boot:run",
    "compose:up": "docker compose up --build",
    "compose:down": "docker compose down",
    "compose:prod:up": "docker compose -f docker-compose.production.yml up --build -d",
    "compose:prod:down": "docker compose -f docker-compose.production.yml down",
    "test": "node scripts/nx.mjs run-many -t test",
    "lint": "node scripts/nx.mjs run-many -t lint",
    "affected:build": "node scripts/nx.mjs affected -t build",
    "affected:test": "node scripts/nx.mjs affected -t test",
    "affected:lint": "node scripts/nx.mjs affected -t lint",
    "graph": "node scripts/nx.mjs graph",
    "nx": "node scripts/nx.mjs",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:debug": "playwright test --debug",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report tests/e2e/playwright-report",
    "e2e:docker": "bash tests/e2e/scripts/check-e2e-env.sh && node scripts/with-env.mjs E2E_DOCKER=true -- playwright test",
    "e2e:docker:headed": "bash tests/e2e/scripts/check-e2e-env.sh && node scripts/with-env.mjs E2E_DOCKER=true HEADED=true -- playwright test --headed",
    "e2e:docker:slow": "bash tests/e2e/scripts/check-e2e-env.sh && node scripts/with-env.mjs E2E_DOCKER=true HEADED=true SLOW_MO=500 -- playwright test --headed",
    "e2e:docker:debug": "bash tests/e2e/scripts/check-e2e-env.sh && node scripts/with-env.mjs E2E_DOCKER=true -- playwright test --debug",
    "e2e:docker:ui": "bash tests/e2e/scripts/check-e2e-env.sh && node scripts/with-env.mjs E2E_DOCKER=true -- playwright test --ui",
    "e2e:env:start": "bash tests/e2e/scripts/e2e-env.sh start",
    "e2e:env:stop": "bash tests/e2e/scripts/e2e-env.sh stop",
    "e2e:env:status": "bash tests/e2e/scripts/e2e-env.sh status",
    "e2e:env:logs": "bash tests/e2e/scripts/e2e-env.sh logs",
    "e2e:env:check": "bash tests/e2e/scripts/check-e2e-env.sh",
    "ui:storybook": "node scripts/nx.mjs storybook ui",
    "ui:storybook:build": "node scripts/nx.mjs build-storybook ui",
    "seed:operators": "bash scripts/seed-operator-conductor-profiles.sh",
    "simulate:device": "node tools/device-simulator/simulate.mjs",
    "apk:conductor": "pnpm --filter busmatelkconductorapp run build:android",
    "apk:conductor:production": "pnpm --filter busmatelkconductorapp run build:android:production",
    "apk:passenger": "pnpm --filter smart-bus-sri-lanka run build:android",
    "apk:passenger:production": "pnpm --filter smart-bus-sri-lanka run build:android:production"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.54.1",
    "nx": "^21.0.0",
    "shadcn": "^4.0.2"
  },
  "pnpm": {
    "overrides": {}
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  }
}
