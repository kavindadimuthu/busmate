{
  "name": "busmate",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "dev:conductor-mobile": "pnpm --filter busmatelkconductorapp dev",
    "dev:management-portal": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx dev management-portal",
    "dev:passenger-mobile": "pnpm --filter smart-bus-sri-lanka dev",
    "dev:passenger-web": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx dev passenger-web",
    "dev:api-gateway": "pnpm --filter api-gateway dev",
    "dev:new-react-portal": "pnpm --filter @busmate/new-react-portal dev",
    "dev:core-service": "cd apps/backend/core-service && ./mvnw spring-boot:run",
    "dev:user-service": "cd apps/backend/user-service && ./mvnw spring-boot:run",
    "dev:ticketing-service": "cd apps/backend/ticketing-service && ./mvnw spring-boot:run",
    "dev:core-service:jar": "SPRINGDOTENV_DIRECTORY=config/secrets java -jar apps/backend/core-service/target/core-service-0.0.1-SNAPSHOT.jar",
    "dev:user-service:jar": "SPRINGDOTENV_DIRECTORY=config/secrets java -jar apps/backend/user-service/target/user-service-0.0.1-SNAPSHOT.jar",
    "dev:ticketing-service:jar": "SPRINGDOTENV_DIRECTORY=config/secrets java -jar apps/backend/ticketing-service/target/ticketing-service-0.0.1-SNAPSHOT.jar",
    "dev:backend": "docker compose up --build",
    "dev-portal": "pnpm --filter @busmate/dev-portal dev",
    "dev-portal:web": "pnpm --filter @busmate/dev-portal dev:web",
    "db:dev:up": "docker compose up -d postgres",
    "db:dev:down": "docker compose stop postgres",
    "db:dev:logs": "docker compose logs -f postgres",
    "db:dev:reset": "docker compose rm -sf postgres && docker volume rm busmate_busmate_dev_postgres_data && docker compose up -d postgres",
    "db:dev:psql": "docker compose exec postgres psql -U postgres",
    "db:dev:gui": "docker compose -f tools/dbgate/docker-compose.yml up -d",
    "db:dev:gui:down": "docker compose -f tools/dbgate/docker-compose.yml down",
    "db:dev:gui:logs": "docker compose -f tools/dbgate/docker-compose.yml logs -f dbgate",
    "build": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx run-many -t build",
    "build:management-portal": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx build management-portal",
    "build:passenger-web": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx build passenger-web",
    "build:core-service": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx run core-service:package",
    "build:user-service": "cd apps/backend/user-service && ./mvnw clean package -DskipTests",
    "build:ticketing-service": "cd apps/backend/ticketing-service && ./mvnw clean package -DskipTests",
    "build:api-gateway": "pnpm --filter api-gateway build",
    "build:new-react-portal": "pnpm --filter @busmate/new-react-portal build",
    "serve:core-service": "cd apps/backend/core-service && ./mvnw spring-boot:run",
    "compose:up": "docker compose up --build",
    "compose:down": "docker compose down",
    "compose:prod:up": "docker compose -f docker-compose.production.yml up --build -d",
    "compose:prod:down": "docker compose -f docker-compose.production.yml down",
    "test": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx run-many -t test",
    "lint": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx run-many -t lint",
    "affected:build": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx affected -t build",
    "affected:test": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx affected -t test",
    "affected:lint": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx affected -t lint",
    "graph": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx graph",
    "nx": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:debug": "playwright test --debug",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report tests/e2e/playwright-report",
    "e2e:docker": "bash tests/e2e/scripts/check-e2e-env.sh && E2E_DOCKER=true playwright test",
    "e2e:docker:headed": "bash tests/e2e/scripts/check-e2e-env.sh && E2E_DOCKER=true HEADED=true playwright test --headed",
    "e2e:docker:slow": "bash tests/e2e/scripts/check-e2e-env.sh && E2E_DOCKER=true HEADED=true SLOW_MO=500 playwright test --headed",
    "e2e:docker:debug": "bash tests/e2e/scripts/check-e2e-env.sh && E2E_DOCKER=true playwright test --debug",
    "e2e:docker:ui": "bash tests/e2e/scripts/check-e2e-env.sh && E2E_DOCKER=true playwright test --ui",
    "e2e:env:start": "bash tests/e2e/scripts/e2e-env.sh start",
    "e2e:env:stop": "bash tests/e2e/scripts/e2e-env.sh stop",
    "e2e:env:status": "bash tests/e2e/scripts/e2e-env.sh status",
    "e2e:env:logs": "bash tests/e2e/scripts/e2e-env.sh logs",
    "e2e:env:check": "bash tests/e2e/scripts/check-e2e-env.sh",
    "ui:storybook": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx storybook ui",
    "ui:storybook:build": "NX_DAEMON=false NX_ISOLATE_PLUGINS=false nx build-storybook ui",
    "seed:operators": "bash scripts/seed-operator-conductor-profiles.sh",
    "apk:conductor": "pnpm --filter busmatelkconductorapp run build:android",
    "apk:conductor:production": "pnpm --filter busmatelkconductorapp run build:android:production",
    "apk:passenger": "pnpm --filter smart-bus-sri-lanka run build:android",
    "apk:passenger:production": "pnpm --filter smart-bus-sri-lanka run build:android:production"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.54.1",
    "nx": "^21.0.0",
    "shadcn": "^4.0.2"
  },
  "pnpm": {
    "overrides": {}
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  }
}
