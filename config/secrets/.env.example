# ============================================================================
#  BusMate — Central backend secrets & environment (TEMPLATE)
# ============================================================================
#  Copy this file to `.env` in the same directory and fill in real values:
#
#      cp config/secrets/.env.example config/secrets/.env
#
#  The real `.env` is gitignored — never commit it. This template IS committed,
#  so it must contain ONLY placeholders, never real credentials.
#
#  This is the single source of truth for every backend service's secrets.
#  Consumers: api-gateway (Node), core-service, user-service, ticketing-service
#  (Spring — loaded automatically via spring-dotenv). See README.md.
#
#  Variable names are SERVICE-SCOPED (CORE_DB_*, USER_DB_*, ...) on purpose:
#  every service loads this whole file, so generic SPRING_DATASOURCE_* /
#  SERVER_PORT names would collide. Keep them scoped.
# ============================================================================

# ── Shared Supabase auth (JWT verification — same project across services) ──
# SUPABASE_JWT_SECRET is now only the *legacy* HS256 verification path (auth migration Phase 2b —
# see docs/plans/Self-Hosted-Auth-Migration-Plan.md): access tokens are RS256-signed by
# user-service's own key below, and every verifier accepts HS256 only for tokens issued before
# the cutover. Keep this set until those have all expired, then it (and this variable) can go.
SUPABASE_JWT_SECRET=<supabase-jwt-secret>
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>

# ── user-service RSA access-token signing key (auth migration Phase 2b) ─────
# Required in any environment running more than one user-service instance — an instance that
# falls back to the built-in ephemeral-keypair generator mints tokens no *other* instance (nor
# anyone relying on GET /public/jwks.json) can verify. Generate with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl pkey -in private.pem -pubout -out public.pem
# then paste each PEM's contents below with real newlines replaced by literal \n.
#
# Leave BOTH empty for a single local-dev instance: user-service then generates an ephemeral
# keypair at startup. They must be empty, not a placeholder — a non-blank value is parsed as a
# PEM and fails startup with "Illegal base64 character". Set both, or neither.
AUTH_JWT_RSA_PRIVATE_KEY=
AUTH_JWT_RSA_PUBLIC_KEY=
AUTH_JWT_RSA_KID=busmate-user-service-key-1

# ── user-service outbound email (auth migration Phase 3 — password reset / email verify) ──
# Left unset, EmailService logs the would-be email instead of sending, so local dev/CI need no
# setup. Set these for any environment that should actually deliver reset/verify emails — any
# SMTP provider works (Gmail, SES's SMTP interface, Mailtrap for a safe dev sandbox, Resend, ...).
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_USERNAME=<smtp-username>
SMTP_PASSWORD=<smtp-password>
AUTH_EMAIL_FROM=no-reply@busmate.lk
# Frontend pages that read ?token=... and call POST /api/auth/reset-password /
# /api/auth/verify-email. Neither page exists yet in any app — override once one does.
AUTH_RESET_PASSWORD_URL=http://localhost:3000/reset-password
AUTH_VERIFY_EMAIL_URL=http://localhost:3000/verify-email

# ── user-service social login (auth migration Phase 4 — passengers only) ──
# client-id is each provider's OAuth app/client id (the audience the ID token is issued for).
# Left unset, that provider's social login endpoint fails with a clear config error the first
# time it's called rather than at startup. issuer/jwks-uri rarely need overriding — they're the
# providers' own well-known endpoints.
AUTH_SOCIAL_GOOGLE_CLIENT_ID=<google-oauth-client-id>
AUTH_SOCIAL_FACEBOOK_CLIENT_ID=<facebook-app-id>

# ── Inter-service shared secret (gates /internal/**, bypasses the gateway) ──
INTERNAL_API_KEY=<generate-a-secure-random-string>

# ── user-service database ───────────────────────────────────────────────────
USER_DB_URL=jdbc:postgresql://<pooler-host>:6543/postgres?sslmode=require
USER_DB_USERNAME=postgres.<project-ref>
USER_DB_PASSWORD=<db-password>

# ── core-service database ───────────────────────────────────────────────────
CORE_DB_URL=jdbc:postgresql://<pooler-host>:6543/postgres
CORE_DB_USERNAME=postgres.<project-ref>
CORE_DB_PASSWORD=<db-password>

# ── ticketing-service database ──────────────────────────────────────────────
TICKETING_DB_URL=jdbc:postgresql://<pooler-host>:6543/postgres?sslmode=require
TICKETING_DB_USERNAME=postgres.<project-ref>
TICKETING_DB_PASSWORD=<db-password>

# ── ticketing-service Supabase auth ─────────────────────────────────────────
TICKETING_SUPABASE_API_KEY=<supabase-anon-key>
TICKETING_SUPABASE_AUTH_URL=https://<project-ref>.supabase.co/auth/v1

# ── External APIs ───────────────────────────────────────────────────────────
GEMINI_API_KEY=<google-gemini-api-key>

# ── Gateway / CORS (local-dev topology; docker-compose overrides the URLs) ──
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:4000,http://localhost:5173
USER_SERVICE_URL=http://localhost:9020
CORE_SERVICE_URL=http://localhost:9010
TICKETING_SERVICE_URL=http://localhost:9030
